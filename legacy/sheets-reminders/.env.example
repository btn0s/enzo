# Local CLI configuration. Copy this file to .env and replace the placeholders.
ENZO_ENDPOINT=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
ENZO_API_TOKEN=replace-with-a-long-random-value
ENZO_TIMEZONE=America/Phoenix
ENZO_INTERVAL_MINUTES=180
ENZO_REMINDER_LIST=Home
ENZO_REMINDER_NAME='Feed Enzo'
ENZO_REMINDER_ATTEMPTS=3
ENZO_REMINDER_TIMEOUT_SECONDS=30

# Native local app storage (Homebrew Postgres; no Docker required).
DATABASE_URL=postgresql://localhost/enzo
